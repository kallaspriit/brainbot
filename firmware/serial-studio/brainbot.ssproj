            "frameEnd": ";",
            "frameParserCode": "/**\n * Splits a Brainbot telemetry frame into its fields.\n *\n * The firmware sends \"$distance,beamAngle,targetAngle,position,speed,load,\n * current,voltage,temperature;\" once every 30 ms while \"debug on\" is active.\n * Everything outside the $ ... ; delimiters is console text and is ignored.\n *\n * @param[in]  frame   The frame body, without the delimiters.\n * @return     An array of strings, one per dataset index.\n */\nfunction parse(frame) {\n    return frame.split(',');\n}\n",
            "frameStart": "$",
            "hexadecimalDelimiters": false,
            "sourceId": 0,
            "title": "Brainbot"
        }
    ],
